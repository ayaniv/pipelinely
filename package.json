{
  "name": "pipelinely",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx --watch src/server.ts",
    "test": "vitest run",
    "pipelinely-merge": "tsx src/pipelinelyMergeCli.ts",
    "pipelinely-onboard": "tsx src/pipelinelyOnboardCli.ts",
    "test:e2e": "playwright test --project=ui",
    "test:e2e:integration": "bash scripts/e2e-integration/run.sh",
    "validate:toolbox": "tsx scripts/validateToolbox.ts"
  },
  "main": "src/server.ts",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.5.3",
    "execa": "^9.6.1",
    "express": "^4.18.2",
    "open": "^9.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.9",
    "yaml": "^2.9.1"
  }
}
