#!/usr/bin/env bash
# Stand-in for GitHub's `gh` CLI, put first on PATH for every e2e run (see
# playwright.config.ts). It serves canned PR state from ../gh/prs/<N>.json,
# records `pr merge` calls to ../gh/merge-calls/<N>.log, and records/fakes
# `api -X DELETE .../refs/heads/<branch>` + `api .../matching-refs/heads/<branch>`
# (the remote-branch-delete step — see cockpit-merge-gate.spec.ts) instead of
# touching a real remote, so no e2e spec can ever merge a real PR or delete a
# real branch, and the merge gate's blocked/green paths are reproducible
# offline. Any command it doesn't model fails loudly rather than pretending
# to succeed.
set -u
GH_FIXTURES="$(cd "$(dirname "$0")/../gh" && pwd)"

if [ "$#" -lt 2 ]; then
  echo "fake gh: unsupported command: $*" >&2
  exit 1
fi

# `gh api -X DELETE repos/{owner}/{repo}/git/refs/heads/<branch>` and
# `gh api repos/{owner}/{repo}/git/matching-refs/heads/<branch>` — the
# literal `{owner}/{repo}` template is real `gh api` syntax (it resolves
# them from the cwd's git remote); the fake never needs to resolve them,
# it only reads the branch name out of the trailing path segment.
if [ "$1" = "api" ]; then
  shift
  method="GET"
  if [ "$1" = "-X" ]; then
    method="$2"
    shift 2
  fi
  endpoint="$1"
  branch="${endpoint##*/heads/}"
  # Per-branch filenames keep parallel workers from interleaving (same
  # reasoning as merge-calls/<N>.log) — "/" -> "__" since a branch name
  # itself contains "/" (claude/<slug>).
  safe_branch="${branch//\//__}"

  case "$endpoint" in
    */git/refs/heads/*)
      if [ "$method" != "DELETE" ]; then
        echo "fake gh: unsupported api method for refs/heads: $method" >&2
        exit 1
      fi
      # Logged as an attempt regardless of outcome — readDeleteRefCalls
      # proves a DELETE was tried, not that it succeeded (the "already
      # gone"/"delete fails" fixtures both attempt and then fail it).
      mkdir -p "$GH_FIXTURES/delete-ref-calls"
      echo "DELETE $endpoint" >> "$GH_FIXTURES/delete-ref-calls/$safe_branch.log"
      if [ -f "$GH_FIXTURES/refs/$safe_branch.absent" ] || [ -f "$GH_FIXTURES/refs/$safe_branch.delete-error" ]; then
        echo 'gh: Reference does not exist (HTTP 422)' >&2
        exit 1
      fi
      exit 0
      ;;
    */git/matching-refs/heads/*)
      if [ -f "$GH_FIXTURES/refs/$safe_branch.absent" ]; then
        echo '[]'
      else
        echo "[{\"ref\":\"refs/heads/$branch\"}]"
      fi
      exit 0
      ;;
    *)
      echo "fake gh: unsupported api endpoint: $endpoint" >&2
      exit 1
      ;;
  esac
fi

if [ "$1" != "pr" ]; then
  echo "fake gh: unsupported command: $*" >&2
  exit 1
fi

sub="$2"
pr="$3"
shift 3

case "$sub" in
  view)
    for arg in "$@"; do
      if [ "$arg" = "--web" ]; then
        echo "fake gh: pr view --web is not modeled in e2e" >&2
        exit 1
      fi
    done
    if [ ! -f "$GH_FIXTURES/prs/$pr.json" ]; then
      echo "fake gh: no fixture for PR #$pr" >&2
      exit 1
    fi
    cat "$GH_FIXTURES/prs/$pr.json"
    ;;
  merge)
    if [ -f "$GH_FIXTURES/prs/$pr.merge-error" ]; then
      cat "$GH_FIXTURES/prs/$pr.merge-error" >&2
      exit 1
    fi
    mkdir -p "$GH_FIXTURES/merge-calls"
    echo "pr merge $pr $*" >> "$GH_FIXTURES/merge-calls/$pr.log"
    ;;
  *)
    echo "fake gh: unsupported command: pr $sub" >&2
    exit 1
    ;;
esac
