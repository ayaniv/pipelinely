# Root-level TASK.md is a scratch/dispatch artifact copied in by each
# worker's dispatch step — not meant to be permanent. Anchored to the repo
# root only; tasks/*/TASK.md below is a separate, deliberately tracked file.
/TASK.md

# Unlike the private cockpit-ai repo, this public checkout doesn't track
# task history — a fresh clone ships no tasks/ scaffold at all, so local
# runs generate this directory (TASKS_DIR) and it should stay untracked.
tasks/**
